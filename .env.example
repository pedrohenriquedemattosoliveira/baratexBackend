APP_NAME="BARATEX API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + PostGIS. A migration cria a extensão "postgis" sozinha
# (o usuário precisa ter permissão de CREATE EXTENSION, ou a extensão já
# deve estar habilitada no banco). Ver docs/postgres.md.
#
# Em provedores que entregam uma URL única (Render, Railway, Neon,
# Supabase...), basta preencher DB_URL — ela tem prioridade sobre
# DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD.
DB_CONNECTION=pgsql
# DB_URL=postgresql://usuario:senha@host:5432/baratex_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=baratex_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
# prefer (padrão) | require (bancos gerenciados costumam exigir) | disable
DB_SSLMODE=prefer

# Origens liberadas no CORS, separadas por vírgula. "*" libera todas
# (ok em desenvolvimento). Em produção, liste a URL do front:
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com,https://baratex.netlify.app
CORS_ALLOWED_ORIGINS=*

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# "log" funciona sem infraestrutura extra. Para o chat em tempo real via
# WebSocket, troque para "reverb" e rode `php artisan reverb:start`
# (ver docs/websockets.md).
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT (equivalente a api.jwt.secret / api.jwt.expiration no
# application.properties original). GERE UM SEGREDO NOVO EM PRODUÇÃO:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=9a8f7e6d5c4b3a210123456789abcdef9a8f7e6d5c4b3a210123456789abcdef
JWT_TTL_MINUTES=1440

REVERB_APP_ID=baratex
REVERB_APP_KEY=baratex-key
REVERB_APP_SECRET=baratex-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
