# Copie para ".env" (ao lado do docker-compose.yml) e ajuste.
# Gere o APP_KEY com:  echo "base64:$(openssl rand -base64 32)"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000
APP_PORT=8000

DB_DATABASE=baratex_db
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# Gere com: php -r "echo bin2hex(random_bytes(32));"   (ou: openssl rand -hex 32)
JWT_SECRET=
JWT_TTL_MINUTES=1440

CORS_ALLOWED_ORIGINS=*

# true = popula marcas/modelos e dados de demonstração no 1º start
RUN_SEED=true

# Chat em tempo real: BROADCAST_CONNECTION=reverb e suba com --profile realtime
BROADCAST_CONNECTION=log
